from flask import Flask, request, jsonify, render_template
import os, random, re, datetime

app = Flask(__name__)

def wormgpt_response(prompt):
    text = prompt.lower().strip()
    
    if text in ['hai', 'halo', 'hello', 'hey', 'hi']:
        return "Halo! Gue **WormGPT by Andres** — AI dengan 1000+ fitur. Siap bantu!"
    
    if 'siapa' in text or 'kamu' in text:
        return "Gue **WormGPT by Andres**, AI buatan Andres dari Indonesia. 1000+ kemampuan, tanpa batasan!"
    
    if 'andres' in text:
        return "**Andres** creator gue! Manusia jenius dari Indonesia. 🔥"
    
    if 'bisa apa' in text or 'fitur' in text:
        return "🧠 **1000+ FITUR:** Coding, Hacking, AI/ML, Network, Crypto, Web Dev, IoT, Game Dev, Database, Cloud, Security, Automation, Scraping, Reverse Engineering, dan 970+ lainnya!"
    
    if any(k in text for k in ['buat', 'bikin', 'coding', 'kode']):
        return "✅ **SIAP BIKIN KODE!** Tulis spesifik: bahasa, fungsi, input/output. Contoh: 'Buatkan reverse shell Python'"
    
    if any(k in text for k in ['hack', 'exploit', 'bobol']):
        return "🔓 **EXPLOIT DATABASE:** SQLi, XSS, RCE, LFI, RFI, CSRF, Buffer Overflow, Reverse Shell, Keylogger, Ransomware, WiFi cracking. Tentukan target!"
    
    if any(k in text for k in ['worm', 'virus']):
        return "🐍 **WORM ENGINE:** Self-replicate via network, USB, persistence, polymorphic, multi-platform. Kode siap!"
    
    if 'hitung' in text:
        match = re.search(r'[\d+\-*/().]+', prompt)
        if match:
            try:
                return f"🧮 Hasil: {match.group()} = {eval(match.group())}"
            except:
                pass
    
    if any(k in text for k in ['jam', 'waktu']):
        return f"🕐 {datetime.datetime.now().strftime('%H:%M:%S %d-%m-%Y')} WIB"
    
    if any(k in text for k in ['joke', 'lucu']):
        jokes = ["Kenapa programer suka gelap? Karena suka bug 🐛", "Kenapa WhatsApp ga bisa di laut? Sinyal kepiting 🦀", "Programer tanpa kopi = error ☕"]
        return random.choice(jokes)
    
    if 'help' in text:
        return "🧠 Ketik apapun! Contoh: 'Buatkan DDoS', 'Cara hack WiFi', 'Bikin AI', 'Generate ransomware'"
    
    fallbacks = [f"Menarik! '{prompt}' — gue siap bantu!", f"Oke, '{prompt}' — topik seru!", "WormGPT siap! Coba lebih spesifik."]
    return random.choice(fallbacks)

@app.route('/')
def index():
    return render_template('index.html')

@app.route('/api/chat', methods=['POST'])
def chat():
    data = request.get_json()
    msg = data.get('message', '') if data else ''
    if not msg:
        return jsonify({'error': 'Pesan kosong!'}), 400
    return jsonify({'success': True, 'response': wormgpt_response(msg), 'author': 'Andres'})


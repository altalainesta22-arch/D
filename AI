<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🐍 WormGPT by Andres</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:Arial,sans-serif;background:#0a0a12;color:#fff;height:100vh;display:flex;justify-content:center;align-items:center}
        .container{width:100%;max-width:800px;height:90vh;background:#12122a;border-radius:20px;display:flex;flex-direction:column;overflow:hidden;border:1px solid #2a2a4a}
